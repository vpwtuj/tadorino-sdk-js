{
  "name": "@bright203/tadorino-sdk-js",
  "version": "0.1.0",
  "description": "Tadorino memo REST client for browsers and Node.js",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vpwtuj/tadorino-sdk-js.git"
  },
  "homepage": "https://vpwtuj.github.io/tadorino-sdk-js/",
  "bugs": {
    "url": "https://github.com/vpwtuj/tadorino-sdk-js/issues"
  },
  "keywords": [
    "tadorino",
    "sdk",
    "notes"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/esm/**/*.d.ts",
    "dist/cjs/**/*.d.cts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "examples/vite",
    "examples/express",
    "examples/m2m"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.js",
    "docs:build": "node scripts/docs.mjs",
    "docs:check": "node scripts/docs.mjs --check",
    "examples:check": "npm run check --workspace @tadorino/example-vite && npm run check --workspace @tadorino/example-express && npm run check --workspace @tadorino/example-m2m",
    "pack:check": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm run build && npm run docs:check && npm test && npm run examples:check && npm run pack:check",
    "prepack": "npm run build",
    "dev:vite": "npm run dev --workspace @tadorino/example-vite",
    "browser:check": "playwright test",
    "dev:m2m": "npm run dev --workspace @tadorino/example-m2m"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "typedoc": "0.28.20",
    "@playwright/test": "1.64.1"
  }
}
